DJANGO_SETTINGS_MODULE=config.settings.local
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://surnova:CHANGE_ME@127.0.0.1:54329/surnova
POSTGRES_DB=surnova
POSTGRES_USER=surnova
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8000
ACCESS_TOKEN_LIFETIME_MINUTES=5
REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_RATE=10/min
REGISTER_RATE=5/hour
CHECKOUT_RATE=20/hour
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=surnova
DJANGO_MEDIA_STORAGE=django.core.files.storage.FileSystemStorage
DJANGO_MEDIA_STORAGE_OPTIONS={}
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_URL=/media/
DEMO_CUSTOMER_EMAIL=cliente@example.test
# Optional: set before seed_demo to enable demo login. Never committed.
DEMO_CUSTOMER_PASSWORD=
# Production only: use TLS to PostgreSQL and a shared cache.
DATABASE_SSL_REQUIRE=True
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_NUM_PROXIES=0
